# 复制为 .env 后填写。不填 LLM_API_KEY 也能运行（离线规则模式）。

# 分析大模型（意图解析、补充假设并写检验代码、结论撰写、追问路由），OpenAI 兼容接口，默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 对 DeepSeek 默认关闭思考模式；要开启：LLM_EXTRA_BODY={"thinking": {"type": "enabled"}}

# 自然语言查数的微调模型（配套项目 Text2SQL-Qwen-SFT 微调的 Qwen3.5-9B，vLLM 部署的 OpenAI 兼容地址，例如 http://127.0.0.1:8000/v1）
SQL_LLM_BASE_URL=
SQL_LLM_API_KEY=EMPTY
SQL_LLM_MODEL=sft
SQL_LLM_NO_THINKING=1

# 数仓目录（默认项目下的“数据”目录，里面要有 ecommerce.db 和 fmcg.db）
# WAREHOUSE_DIR=
# 应用数据目录（会话、报告、补录事件、审计日志），默认项目下的 data 目录
# APP_DATA_DIR=

# 判定阈值
CONFIDENCE_THRESHOLD=0.6
MAJOR_SHARE=0.2
MINOR_SHARE=0.02
EVENT_WINDOW_DAYS=3

# 沙箱配额
SANDBOX_TIMEOUT=20
SANDBOX_MEMORY_MB=2048

# PDF 中文字体（不填时自动找 simhei / msyh / simsun / 文泉驿）
# PDF_FONT=C:/Windows/Fonts/simhei.ttf

APP_SECRET=change-me
